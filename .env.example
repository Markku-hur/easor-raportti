# Easor API credentials. Request them from integration.support@easor.com.
# Copy to .env in this folder and fill in. Never commit .env or send it to anyone.
# Restart Claude after every change.

# One block per company: its one API key covers both General Ledger and Sales Invoicing.
# 12345 is the company's Easor organization number. Copy the block for each company.
EASOR_ORG_12345_CLIENT_ID=
EASOR_ORG_12345_CLIENT_SECRET=
EASOR_ORG_12345_SCOPE=
EASOR_ORG_12345_SUBSCRIPTION_KEY=

# Older form, still accepted: separate keys per API (EASOR_ORG_12345_GL_FI_* and
# EASOR_ORG_12345_SALES_FI_*). Either one is also tried for the other API.

# Optional: credentials that cover several companies, used when a company's own key is
# missing or refused.
# EASOR_GL_FI_CLIENT_ID=
# EASOR_GL_FI_CLIENT_SECRET=
# EASOR_GL_FI_SCOPE=
# EASOR_GL_FI_SUBSCRIPTION_KEY=
# EASOR_SALES_FI_CLIENT_ID=
# EASOR_SALES_FI_CLIENT_SECRET=
# EASOR_SALES_FI_SCOPE=
# EASOR_SALES_FI_SUBSCRIPTION_KEY=

# Optional: only if Easor gives you a different identity provider address
# EASOR_TOKEN_URL=

# TLS: on Windows the server also trusts the Windows certificate store (needed when e.g.
# AVG/Avast HTTPS scanning re-signs connections). Set to 0 to use only Node's own list.
# EASOR_WINDOWS_CERTS=0
# Optional: an extra CA certificate file (PEM) to trust.
# EASOR_CA_FILE=
